# Required: the token BotFather gave you.
TELEGRAM_BOT_TOKEN=

# Optional: only these Telegram user ids may use the bot (comma separated).
# Empty means everyone. Find an id by messaging @userinfobot.
ALLOWED_USER_IDS=

# Optional limits.
UPLOAD_LIMIT_MB=49
MAX_MINUTES=90

# Optional: a cookies.txt (Netscape format) of an account YOU control, mounted
# into the container, for sites that want a signed-in visitor.
# COOKIES_FILE=/data/cookies.txt
