{
  "manifest_version": 3,
  "name": "Ratatosk",
  "version": "1.0.0",
  "description": "Send downloads from your browser to Ratatosk on this computer. Local only.",
  "permissions": [
    "downloads",
    "storage",
    "contextMenus",
    "nativeMessaging"
  ],
  "optional_permissions": [
    "cookies"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ratatosk",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
