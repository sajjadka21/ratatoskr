{
  "manifest_version": 3,
  "name": "Download Manager Handoff",
  "version": "1.0.0",
  "description": "Optional, local-only handoff to Download Manager.",
  "permissions": ["downloads", "storage", "contextMenus", "nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Download Manager", "default_popup": "popup.html" },
  "options_page": "options.html"
}
