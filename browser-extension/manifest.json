{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "version": "1.2.0",
  "description": "__MSG_description__",
  "default_locale": "en",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "downloads",
    "storage",
    "contextMenus",
    "nativeMessaging"
  ],
  "optional_permissions": [
    "cookies",
    "scripting"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "__MSG_name__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browser@ratatosk.app",
      "strict_min_version": "121.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.aparat.com/*",
        "*://*.vimeo.com/*",
        "*://*.instagram.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.tiktok.com/*",
        "*://*.dailymotion.com/*",
        "*://*.twitch.tv/*",
        "*://*.facebook.com/*",
        "*://*.reddit.com/*",
        "*://*.bilibili.com/*"
      ],
      "js": [
        "video.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
